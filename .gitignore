# ============================================
# ROOT .gitignore - PulsePay Monorepo
# ============================================
# This file contains GLOBAL rules that apply to ALL projects.
# Each subproject has its own .gitignore for project-specific rules.
# Git automatically uses all .gitignore files hierarchically.
# ============================================

# ----------------------
# Operating System
# ----------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ----------------------
# IDEs & Editors
# ----------------------
.idea/
*.swp
*.swo
*~
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.sublime-workspace
*.sublime-project

# ----------------------
# Environment Files
# ----------------------
.env
.env.local
.env.*.local
*.local.env
!.env.example

# ----------------------
# Logs
# ----------------------
logs/
*.log

# ----------------------
# Docker (local dev data)
# ----------------------
.docker-data/

# ----------------------
# Temporary Files
# ----------------------
tmp/
temp/
*.tmp
.tmp/
.temp/

# ----------------------
# Project Control (internal only)
# ----------------------
TODO.md
