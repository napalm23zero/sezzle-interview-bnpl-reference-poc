{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build",
      "type": "npm",
      "script": "build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Lint",
      "type": "npm",
      "script": "lint",
      "problemMatcher": ["$eslint-stylish"]
    },
    {
      "label": "Test",
      "type": "npm",
      "script": "test",
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "🔄 Kill Port 3000",
      "type": "shell",
      "command": "lsof -ti:3000 | xargs kill -9 2>/dev/null || echo '✅ Port 3000 is free'",
      "presentation": {
        "reveal": "silent",
        "close": true
      },
      "problemMatcher": []
    },
    {
      "label": "🟢 Dev (Watch Mode)",
      "type": "shell",
      "command": "NODE_ENV=development PORT=3000 LOG_LEVEL=debug npx tsx watch src/index.ts",
      "isBackground": true,
      "dependsOn": ["🔄 Kill Port 3000"],
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "API Gateway running"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dev"
      }
    },
    {
      "label": "🟡 UAT (Watch Mode)",
      "type": "shell",
      "command": "NODE_ENV=uat PORT=3000 LOG_LEVEL=info npx tsx watch src/index.ts",
      "isBackground": true,
      "dependsOn": ["🔄 Kill Port 3000"],
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "API Gateway running"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dev"
      }
    },
    {
      "label": "🔴 PROD (Single Run)",
      "type": "shell",
      "command": "NODE_ENV=production PORT=3000 LOG_LEVEL=warn npx tsx src/index.ts",
      "isBackground": true,
      "dependsOn": ["🔄 Kill Port 3000"],
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "API Gateway running"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dev"
      }
    }
  ]
}
