# API Gateway - Environment Variables
# Copy this file to .env and customize for your environment

# Server Configuration
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Redis (for distributed rate limiting)
REDIS_URL=redis://pulse-redis:6379
REDIS_ENABLED=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_USE_REDIS=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_WHITELIST=
RATE_LIMIT_CUSTOM_PATHS={}
RATE_LIMIT_BAN_ENABLED=false
RATE_LIMIT_BAN_THRESHOLD=10
RATE_LIMIT_BAN_DURATION_MS=3600000

# Service URLs
ORDERS_SERVICE_URL=http://orders-service:3001
SEARCH_SERVICE_URL=http://search-service:3002
WEBHOOKS_SERVICE_URL=http://webhooks-service:3003

# OpenTelemetry (Tracing)
# Uses pulse-otel-collector container from infrastructure
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://pulse-otel-collector:4318
OTEL_SERVICE_NAME=api-gateway

# Metrics (Prometheus)
# Exposes /metrics endpoint for pulse-prometheus to scrape
METRICS_ENABLED=true
